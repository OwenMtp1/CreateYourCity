# Copier en .env pour le développement local. Ne jamais versionner .env.
# Aucune valeur ci-dessous n'est un secret réel.

# --- Serveur de jeu --------------------------------------------------------
PORT=8787
# NODE_ENV=production

# --- Authentification -------------------------------------------------------
# dev : identité invitée signée par le serveur (développement local uniquement)
# supabase : comptes Supabase Auth (production)
AUTH_MODE=dev
# Secret de signature des jetons invités (mode dev). Sans lui, les jetons expirent à chaque redémarrage.
DEV_AUTH_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# Supabase (Project Settings → API). L'URL et la clé anon sont publiques par conception.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optionnel : ancien secret JWT HS256. Si absent, le serveur vérifie les jetons avec les clés
# publiques JWKS du projet (recommandé). Ne JAMAIS mettre la clé service_role ici ou côté client.
SUPABASE_JWT_SECRET=

# --- Persistance -----------------------------------------------------------------
# memory | file | postgres (par défaut : postgres si DATABASE_URL est défini, sinon file)
STORE=
# Chaîne de connexion PostgreSQL. Avec Supabase : utilisez le « Session pooler » (port 5432),
# PAS le « Transaction pooler » (6543) : le verrou d'autorité du monde exige une session.
DATABASE_URL=
# disable | no-verify (chiffré, certificat non vérifié) | verify (avec DATABASE_CA_CERT)
DATABASE_SSL=no-verify
# Certificat CA Supabase (PEM, retours à la ligne en \n) pour DATABASE_SSL=verify
DATABASE_CA_CERT=
# Applique automatiquement les migrations au démarrage
DB_AUTO_MIGRATE=true
# Dossier de sauvegarde pour STORE=file
DATA_DIR=./data

# --- Simulation ---------------------------------------------------------------------
SNAPSHOT_INTERVAL_MS=15000
# Durée maximale d'arrêt rattrapée au redémarrage (au-delà, le temps est sauté et signalé)
MAX_CATCHUP_HOURS=24

# --- Divers --------------------------------------------------------------------------
# Origines autorisées pour le WebSocket, séparées par des virgules (vide = toutes)
ALLOWED_ORIGINS=
