{
  "name": "@cyc/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "start:dev": "tsx src/index.ts",
    "build": "tsc -p . --noEmit && esbuild src/index.ts src/migrate.ts --bundle --splitting --platform=node --format=esm --target=node22 --sourcemap --outdir=dist --external:pg --external:ws --external:jose --external:zod",
    "migrate": "tsx --env-file-if-exists=../.env src/migrate.ts",
    "migrate:prod": "node --enable-source-maps dist/migrate.js",
    "budget:reset": "tsx --env-file-if-exists=../.env src/resetNationBudgets.ts"
  },
  "dependencies": {
    "@cyc/shared": "*",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2"
  }
}
